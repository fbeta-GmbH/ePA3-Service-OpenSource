# RU (RU REF) , RT (RU DEV) or PROD
EPA_ENVIRONMENT = 'RT'

# The assigned number of the ePA provider (IBM=1, RISE=2) (epa-as-<provider-number>) to use as fallback
#   See: https://gemspec.gematik.de/docs/gemSpec/gemSpec_Aktensystem_ePAfueralle/latest/#A_24592-02
DEFAULT_EPA_PROVIDER_ID = 2

USER_AGENT = 'usrAgent/1.1.0'
# The url or ip address of the Konnektor to connect to. 
# This is typically provided by your Konnektor / TI-as-a-Service provider or can be found in your TI Client configuration file. 
KONNEKTOR_URL = 'https://konnektor-2.ru.tiaas.rise-ti.de'

# password for the konnektor '.p12' certificate
KONNEKTOR_CERT_PW = '0000'

# URL to the trusted Konnektor server certificates (provided by your Konnektor / TI-as-a-Service provider).
# This is used to verify the identity of your Konnektor when the service communicates with it.
#
# Why this is needed:
#   Without this URL, the service CANNOT verify that it is actually talking to the real Konnektor.
#   This means the connection is not protected against interception or impersonation.
#
# What to do:
#   Ask your Konnektor provider (e.g. RISE, arvato, etc.) for the correct URL.
#   It typically points to a '.jws' file containing the Konnektor's trusted server certificates.
#
# If not set:
#   The service can only start if an existing local Konnektor CA bundle is already present. Otherwise startup fails.
# If set:
#   The URL must be valid. If not, startup fails.
#
# Example URLs (provided by RISE):
#   RU (test):       https://client.rise-tiaas.de/update-tiaas-ru/trusted-server-certs-ru.jws
#   PU (production): https://client.rise-tiaas.de/update-tiaas-pu/trusted-server-certs.jws
KONNEKTOR_JWS_URL = "https://client.rise-tiaas.de/update-tiaas-ru/trusted-server-certs-ru.jws"

# INSECURE: skips Konnektor TLS certificate verification.
# This should only be used temporarily for testing when no KONNEKTOR_JWS_URL can be provided. 
# Setting this to 'true' is mutually exclusive with setting the KONNEKTOR_JWS_URL.
# Default: false
KONNEKTOR_ALLOW_INSECURE_TLS = false



